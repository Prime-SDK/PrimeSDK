.auto-ads-countdown-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.72);
}

.auto-ads-countdown-panel {
    width: 360px;
    max-width: 86%;
    min-height: 150px;
    align-items: center;
    justify-content: center;
    background-color: rgb(14, 15, 16);
    border-top-width: 3px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-color: rgb(255, 125, 20);
    border-right-color: rgb(255, 125, 20);
    border-bottom-color: rgb(255, 125, 20);
    border-left-color: rgb(255, 125, 20);
    padding-top: 22px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
}

.auto-ads-countdown-title {
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(255, 125, 20);
    -unity-text-align: middle-center;
    white-space: normal;
}

.auto-ads-countdown-value {
    -unity-font-style: bold;
    font-size: 56px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    margin-top: 8px;
}
