.sdk-analyzer-root {
    flex-grow: 1;
}

.sdk-analyzer-scroll {
    flex-grow: 1;
}

.sdk-analyzer-content {
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 14px;
    padding-bottom: 18px;
}

.sdk-analyzer-header {
    background-color: rgb(14, 15, 16);
    border-top-width: 3px;
    border-top-color: rgb(255, 125, 20);
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 14px;
}

.sdk-analyzer-title {
    -unity-font-style: bold;
    font-size: 22px;
    color: rgb(255, 125, 20);
}

.sdk-analyzer-description {
    white-space: normal;
    margin-top: 4px;
    color: rgb(199, 199, 199);
}

.sdk-analyzer-actions {
    flex-direction: row;
    margin-top: 14px;
}

.sdk-analyzer-status {
    white-space: normal;
    margin-top: 10px;
    color: rgb(209, 209, 209);
}

.sdk-analyzer-results {
    margin-top: 12px;
}

.sdk-analyzer-result-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(14, 15, 16);
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
}

.sdk-analyzer-result-text {
    flex-grow: 1;
}

.sdk-analyzer-result-title {
    -unity-font-style: bold;
    font-size: 13px;
    color: rgb(255, 255, 255);
}

.sdk-analyzer-result-path {
    white-space: normal;
    font-size: 12px;
    color: rgb(189, 189, 189);
}

.sdk-analyzer-result-evidence {
    white-space: normal;
    font-size: 11px;
    color: rgb(143, 143, 143);
}

.sdk-analyzer-inspector {
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
}

.sdk-analyzer-inspector-title {
    -unity-font-style: bold;
    font-size: 15px;
    color: rgb(255, 125, 20);
}

.sdk-analyzer-inspector-reason {
    white-space: normal;
    margin-top: 8px;
    font-size: 12px;
    color: rgb(209, 209, 209);
}

.sdk-analyzer-inspector-detail {
    white-space: normal;
    margin-top: 4px;
    font-size: 11px;
    color: rgb(173, 173, 173);
}

.sdk-analyzer-inspector-folder {
    margin-top: 10px;
}

.sdk-analyzer-inspector-code-title {
    -unity-font-style: bold;
    margin-top: 10px;
    font-size: 11px;
    color: rgb(255, 125, 20);
}

.sdk-analyzer-inspector-code-line {
    white-space: normal;
    font-size: 11px;
    color: rgb(224, 224, 224);
}

.sdk-analyzer-inspector-select {
    margin-top: 12px;
}
